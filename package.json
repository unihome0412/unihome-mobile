{
  "name": "unihome-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:security": "jest --testPathPattern=__tests__/security",
    "test:coverage": "jest --ci --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint App.tsx index.ts src __tests__ --max-warnings=0",
    "format": "prettier --write \"*.{json,js,mjs,ts}\" \"__tests__/**/*.json\" \".github/**/*.{yml,yaml}\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"*.{json,js,mjs,ts}\" \"__tests__/**/*.json\" \".github/**/*.{yml,yaml}\" \"scripts/**/*.mjs\"",
    "sbom": "npm sbom --sbom-format=cyclonedx --omit=dev",
    "verify:workflows": "node scripts/lib/workflow-security.mjs .github/workflows",
    "verify:android-manifest": "node scripts/verify-android-manifest.mjs",
    "verify:sbom": "node scripts/verify-sbom.mjs",
    "coverage:summary": "node scripts/coverage-summary.mjs",
    "test:pipeline": "node --test scripts/lib/workflow-security.test.mjs scripts/lib/play-release.test.mjs scripts/lib/release-provenance.test.mjs"
  },
  "dependencies": {
    "@react-navigation/native": "^7.1.0",
    "@react-navigation/native-stack": "^7.1.0",
    "expo": "~58.0.23",
    "expo-asset": "~58.0.20",
    "expo-constants": "~58.0.15",
    "expo-font": "~58.0.11",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.1"
  },
  "devDependencies": {
    "@babel/core": "^8.1.0",
    "@react-native/jest-preset": "^0.88.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "eslint": "9.39.5",
    "eslint-config-expo": "58.0.4",
    "jest": "^29.7.0",
    "jest-expo": "~58.0.2",
    "prettier": "3.10.1",
    "typescript": "~6.0.3",
    "yaml": "2.9.1"
  },
  "jest": {
    "preset": "jest-expo",
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts"
    ],
    "coverageReporters": [
      "text",
      "lcov",
      "json-summary"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 7,
        "functions": 11,
        "lines": 13,
        "statements": 13
      }
    }
  },
  "private": true
}
